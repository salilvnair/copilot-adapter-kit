{
  "name": "copilot-adapter-kit",
  "displayName": "Copilot Adapter Kit",
  "description": "Plugin-based provider mesh for Copilot Chat. BYOK, zero config.",
  "icon": "resources/icon.png",
  "version": "2.0.5",
  "publisher": "salilvnair",
  "license": "MIT",
  "author": "salilvnair",
  "repository": {
    "type": "git",
    "url": "https://github.com/salilvnair/copilot-adapter-kit.git"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "cak-icon": {
        "description": "Copilot Adapter Kit",
        "default": {
          "fontPath": "resources/cak-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cak-git-sidebar",
          "title": "CAK Git",
          "icon": "$(cak-icon)"
        }
      ]
    },
    "views": {
      "cak-git-sidebar": [
        {
          "type": "webview",
          "id": "cak.miniGitPanel",
          "name": "Git AI",
          "icon": "$(cak-icon)"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "copilot-adapter-kit",
        "displayName": "Copilot Adapter Kit"
      }
    ],
    "commands": [
      {
        "command": "copilot-adapter-kit.openPanel",
        "title": "%copilot-adapter-kit.command.openPanel%"
      },
      {
        "command": "copilot-adapter-kit.setApiKey",
        "title": "%copilot-adapter-kit.command.setApiKey%"
      },
      {
        "command": "copilot-adapter-kit.clearApiKey",
        "title": "%copilot-adapter-kit.command.clearApiKey%"
      },
      {
        "command": "copilot-adapter-kit.addModel",
        "title": "%copilot-adapter-kit.command.addModel%"
      },
      {
        "command": "copilot-adapter-kit.removeModel",
        "title": "%copilot-adapter-kit.command.removeModel%"
      },
      {
        "command": "copilot-adapter-kit.addProvider",
        "title": "%copilot-adapter-kit.command.addProvider%"
      },
      {
        "command": "copilot-adapter-kit.removeProvider",
        "title": "%copilot-adapter-kit.command.removeProvider%"
      },
      {
        "command": "copilot-adapter-kit.configure",
        "title": "%copilot-adapter-kit.command.configure%"
      },
      {
        "command": "copilot-adapter-kit.openSettings",
        "title": "%copilot-adapter-kit.command.openSettings%"
      },
      {
        "command": "copilot-adapter-kit.showLogs",
        "title": "%copilot-adapter-kit.command.showLogs%"
      },
      {
        "command": "copilot-adapter-kit.openDumps",
        "title": "%copilot-adapter-kit.command.openDumps%"
      },
      {
        "command": "copilot-adapter-kit.generateCommitMessage",
        "title": "%copilot-adapter-kit.command.generateCommitMessage%"
      },
      {
        "command": "copilot-adapter-kit.statusMenu",
        "title": "%copilot-adapter-kit.command.statusMenu%"
      },
      {
        "command": "copilot-adapter-kit.showUsage",
        "title": "%copilot-adapter-kit.command.showUsage%"
      },
      {
        "command": "copilot-adapter-kit.resetBudget",
        "title": "%copilot-adapter-kit.command.resetBudget%"
      },
      {
        "command": "copilot-adapter-kit.disableSpendGuard",
        "title": "%copilot-adapter-kit.command.disableSpendGuard%"
      },
      {
        "command": "copilot-adapter-kit.enableSpendGuard",
        "title": "%copilot-adapter-kit.command.enableSpendGuard%"
      },
      {
        "command": "copilot-adapter-kit.openHarness",
        "title": "%copilot-adapter-kit.command.openHarness%"
      }
    ],
    "configuration": {
      "title": "%copilot-adapter-kit.config.title%",
      "properties": {
        "copilot-adapter-kit.providers": {
          "type": "object",
          "default": {},
          "description": "%copilot-adapter-kit.config.providers%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "API endpoint for this provider."
              },
              "defaultApiPath": {
                "type": "string",
                "description": "Default API path (e.g. /chat/completions, /responses). Default: /chat/completions."
              },
              "modelApiPaths": {
                "type": "object",
                "description": "Per-model API path overrides. Key = model ID, value = path (e.g. /responses for codex).",
                "additionalProperties": true
              },
              "modelAlias": {
                "type": "object",
                "description": "Map picker model IDs → provider model names.",
                "additionalProperties": true
              }
            }
          }
        },
        "copilot-adapter-kit.budget.enforce": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%copilot-adapter-kit.config.budget.enforce%"
        },
        "copilot-adapter-kit.budget.dailyTokenLimit": {
          "type": "number",
          "default": 2000000,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.budget.dailyTokenLimit%"
        },
        "copilot-adapter-kit.budget.dailyCostLimitUsd": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.budget.dailyCostLimitUsd%"
        },
        "copilot-adapter-kit.budget.maxInputTokensPerRequest": {
          "type": "number",
          "default": 200000,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.budget.maxInputTokensPerRequest%"
        },
        "copilot-adapter-kit.budget.maxOutputTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.budget.maxOutputTokens%"
        },
        "copilot-adapter-kit.budget.maxTurnsPerConversation": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.budget.maxTurnsPerConversation%"
        },
        "copilot-adapter-kit.audit.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%copilot-adapter-kit.config.audit.enabled%"
        },
        "copilot-adapter-kit.audit.recordBodies": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%copilot-adapter-kit.config.audit.recordBodies%"
        },
        "copilot-adapter-kit.audit.retentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "%copilot-adapter-kit.config.audit.retentionDays%"
        },
        "copilot-adapter-kit.audit.dbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%copilot-adapter-kit.config.audit.dbPath%"
        },
        "copilot-adapter-kit.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%copilot-adapter-kit.config.maxTokens%"
        },
        "copilot-adapter-kit.models": {
          "type": "object",
          "default": {},
          "description": "%copilot-adapter-kit.config.models%",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "family"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "family": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "maxIn": {
                  "type": "number"
                },
                "maxOut": {
                  "type": "number"
                },
                "image": {
                  "type": "boolean"
                },
                "thinking": {
                  "type": "boolean"
                },
                "pricing": {
                  "type": "string"
                }
              }
            }
          }
        },
        "copilot-adapter-kit.hiddenBuiltins": {
          "type": "array",
          "default": [],
          "description": "%copilot-adapter-kit.config.hiddenBuiltins%"
        },
        "copilot-adapter-kit.modelOverrides": {
          "type": "object",
          "default": {},
          "description": "%copilot-adapter-kit.config.modelOverrides%"
        },
        "copilot-adapter-kit.hiddenCustomModels": {
          "type": "array",
          "default": [],
          "description": "%copilot-adapter-kit.config.hiddenCustomModels%"
        },
        "copilot-adapter-kit.stabilizeTools": {
          "type": "boolean",
          "default": false,
          "description": "%copilot-adapter-kit.config.stabilizeTools%",
          "tags": [
            "experimental"
          ]
        },
        "copilot-adapter-kit.logLevel": {
          "type": "string",
          "default": "quiet",
          "enum": [
            "quiet",
            "meta",
            "dump"
          ],
          "description": "%copilot-adapter-kit.config.logLevel%"
        },
        "copilot-adapter-kit.visionFallbackModel": {
          "type": "string",
          "default": "",
          "description": "%copilot-adapter-kit.config.visionFallbackModel%"
        },
        "copilot-adapter-kit.visionFallbackAlways": {
          "type": "boolean",
          "default": false,
          "description": "%copilot-adapter-kit.config.visionFallbackAlways%"
        },
        "copilot-adapter-kit.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "%copilot-adapter-kit.config.systemPrompt%"
        },
        "copilot-adapter-kit.userPromptTemplate": {
          "type": "string",
          "default": "",
          "description": "%copilot-adapter-kit.config.userPromptTemplate%"
        },
        "copilot-adapter-kit.gitPrompt": {
          "type": "string",
          "default": "",
          "description": "%copilot-adapter-kit.config.gitPrompt%"
        },
        "copilot-adapter-kit.maxDiffFiles": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "description": "%copilot-adapter-kit.config.maxDiffFiles%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "copilot-adapter-kit.openHarness",
          "when": "copilot-adapter-kit.dev"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && npm run build:webview && npm run build:ext && tsc -p ./",
    "build:ext": "node esbuild.js --production",
    "watch": "npm run clean && npm run build:webview && npm run build:ext && tsc -watch -p ./",
    "install:webview": "npm --prefix webview-ui install",
    "build:webview": "npm --prefix webview-ui run build",
    "watch:webview": "npm --prefix webview-ui run dev",
    "typecheck": "tsc --noEmit -p ./ && npm --prefix webview-ui run typecheck",
    "test": "npm run compile && node test/run.js",
    "test:e2e": "npm --prefix webview-ui run test:e2e",
    "test:all": "npm test && npm run test:e2e",
    "logo": "node scripts/generate-icon-font.js",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "publish:patch": "npx @vscode/vsce publish patch",
    "publish:minor": "npx @vscode/vsce publish minor",
    "publish:major": "npx @vscode/vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "sql.js": "^1.14.2"
  }
}
